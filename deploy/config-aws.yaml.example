# Allotment deployment configuration — copy to deploy/config.yaml and edit.
# cp deploy/config-aws.yaml.example deploy/config.yaml
apiVersion: apiextensions.crossplane.io/v1beta1
kind: EnvironmentConfig
metadata:
  name: allotment-config
data:
  provider: aws
  # AWS account ID: 12 digits, no dashes.
  projectId: "123456789012"
  region: eu-west-1
  # AWS supports 2 to 4 runtime zones. Add more AZ names from this region if
  # they are available in your account. Check with:
  # aws ec2 describe-availability-zones --region eu-west-1 \
  #   --query 'AvailabilityZones[].ZoneName' --output text
  zones:
    - eu-west-1a
    - eu-west-1b
  clusterName: allotment
  createdBy: allotment
  # expiresAt: "2026-06-30"
  dnsDomain: allotment.garden.internal
  awsProfile: default
  # Garden Linux is the OS name; use a region-specific Garden Linux AMI ID.
  awsGardenlinuxAmi: ami-032075382f7aac30e
  awsNodesPerZone: 2
  createShoot: "false"
