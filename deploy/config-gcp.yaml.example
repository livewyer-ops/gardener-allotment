# Allotment deployment configuration — copy to deploy/config.yaml and edit.
# cp deploy/config-gcp.yaml.example deploy/config.yaml
apiVersion: apiextensions.crossplane.io/v1beta1
kind: EnvironmentConfig
metadata:
  name: allotment-config
data:
  provider: gcp
  projectId: your-gcp-project-id
  region: europe-west1
  # GCP supports one or more runtime zones. Total runtime nodes are
  # gcpNodesPerZone × number of zones. Check zone names with:
  # gcloud compute zones list --filter='region:europe-west1' \
  #   --format='value(name)'
  zones:
    - europe-west1-b
    - europe-west1-c
  clusterName: allotment
  createdBy: allotment
  # expiresAt: "2026-06-30"
  dnsDomain: allotment.garden.internal
  vpcNetwork: default
  gcpNodesPerZone: 3
  createShoot: "false"
