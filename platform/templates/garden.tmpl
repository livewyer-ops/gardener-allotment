# Extension: shoot certificate service
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  name: ext-shoot-cert-service
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: ext-shoot-cert
spec:
  deletionPolicy: Orphan
  # See ext-provider-* above: derive readiness from the operator's Installed
  # condition instead of the fragile SuccessfulCreate one-shot.
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status.conditions) && object.status.conditions.exists(c, c.type == "Installed" && c.status == "True")
  forProvider:
    manifest:
      apiVersion: operator.gardener.cloud/v1alpha1
      kind: Extension
      metadata:
        name: extension-shoot-cert-service
        annotations:
          security.gardener.cloud/pod-security-enforce: baseline
      spec:
        deployment:
          extension:
            policy: Always
            injectGardenKubeconfig: true
            helm:
              ociRepository:
                repository: europe-docker.pkg.dev/gardener-project/releases/charts/gardener/extensions/shoot-cert-service
                tag: {{ index $env "certServiceVersion" }}
            values:
              replicaCount: 1
              certificateConfig:
                defaultIssuer:
                  name: default-issuer
                  acme:
                    email: noreply@gardener.cloud
                    # Staging ACME — private DNS can't pass Let's Encrypt validation
                    server: https://acme-staging-v02.api.letsencrypt.org/directory
            runtimeClusterValues:
              certificateConfig:
                defaultIssuer:
                  name: garden
                  acme:
                    email: noreply@gardener.cloud
                    server: https://acme-staging-v02.api.letsencrypt.org/directory
        resources:
        - autoEnable:
          - shoot
          clusterCompatibility:
          - shoot
          kind: Extension
          type: shoot-cert-service
          workerlessSupported: true
        - clusterCompatibility:
          - garden
          - seed
          kind: Extension
          lifecycle:
            delete: AfterKubeAPIServer
            reconcile: BeforeKubeAPIServer
          type: controlplane-cert-service
  providerConfigRef:
    name: runtime
