{{- if eq .observed.composite.resource.kind "XInfra" }}
{{- $root := . }}
{{- $envKey := "apiextensions.crossplane.io/environment" }}
{{- $env := index .context $envKey }}
{{- $provider := index $env "provider" }}
{{- if eq $provider "aws" }}
{{- $clusterName := index $env "clusterName" }}
{{- $region := index $env "region" }}
{{- $zones := index $env "zones" }}
{{- $createdBy := default "allotment" (index $env "createdBy") }}
{{- $expiresAt := default "" (index $env "expiresAt") }}
{{- $awsNodesPerZone := int (default 2 (index $env "awsNodesPerZone")) }}
{{- $desiredNodes := mul (len $zones) $awsNodesPerZone }}
{{- $maxNodes := add $desiredNodes (len $zones) }}
{{- $xrStatus := dig "status" (dict) .observed.composite.resource }}
{{- $podSubnets := default (dict) (dig "podSubnets" (dict) $xrStatus) }}
{{- $clusterSecurityGroup := default "REPLACE" (dig "clusterSecurityGroup" "" $xrStatus) }}
{{- $zoneSlots := list
  (dict "suffix" "a" "publicCidr" "10.0.0.0/19" "privateCidr" "10.0.128.0/19" "podCidr" "100.64.0.0/19")
  (dict "suffix" "b" "publicCidr" "10.0.32.0/19" "privateCidr" "10.0.160.0/19" "podCidr" "100.64.32.0/19")
  (dict "suffix" "c" "publicCidr" "10.0.64.0/19" "privateCidr" "10.0.192.0/19" "podCidr" "100.64.64.0/19")
  (dict "suffix" "d" "publicCidr" "10.0.96.0/19" "privateCidr" "10.0.224.0/19" "podCidr" "100.64.96.0/19")
}}
{{- $zoneData := list }}
{{- range $i, $zoneName := $zones }}
{{- $slot := index $zoneSlots $i }}
{{- $suffix := index $slot "suffix" }}
{{- $podResourceName := printf "subnet-pod-%s" $suffix }}
{{- $observedPodSubnet := dig "resources" $podResourceName "resource" "status" "atProvider" "id" "" $root.observed }}
{{- $statusPodSubnet := get $podSubnets $suffix }}
{{- $podSubnetId := default $statusPodSubnet $observedPodSubnet }}
{{- $zoneData = append $zoneData (dict
  "suffix" $suffix
  "zone" $zoneName
  "publicCidr" (index $slot "publicCidr")
  "privateCidr" (index $slot "privateCidr")
  "podCidr" (index $slot "podCidr")
  "podSubnetId" $podSubnetId
) }}
{{- end }}
{{- $subnetTypes := list
  (dict "access" "public" "cidrKey" "publicCidr" "mapPublicIp" "true" "roleTag" "kubernetes.io/role/elb")
  (dict "access" "private" "cidrKey" "privateCidr" "mapPublicIp" "" "roleTag" "kubernetes.io/role/internal-elb")
  (dict "access" "pod" "cidrKey" "podCidr" "mapPublicIp" "false" "roleTag" "")
}}
{{- range $subnet := $subnetTypes }}
{{- $access := index $subnet "access" }}
{{- range $zone := $zoneData }}
{{- $suffix := index $zone "suffix" }}
---
apiVersion: ec2.aws.upbound.io/v1beta1
kind: Subnet
metadata:
  name: {{ printf "%s-%s-%s" $clusterName $access $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: subnet-{{ $access }}-{{ $suffix }}
  labels:
    access: {{ $access }}
    zone: {{ $suffix }}
    {{ if ne $access "pod" }}
    eks-subnet: "true"
    {{ end }}
spec:
  forProvider:
    region: {{ $region | quote }}
    availabilityZone: {{ index $zone "zone" | quote }}
    cidrBlock: {{ index $zone (index $subnet "cidrKey") | quote }}
    {{ if eq (index $subnet "mapPublicIp") "true" }}
    mapPublicIpOnLaunch: true
    {{ else if eq (index $subnet "mapPublicIp") "false" }}
    mapPublicIpOnLaunch: false
    {{ end }}
    vpcIdSelector:
      matchControllerRef: true
    tags:
      Name: {{ printf "%s-%s-%s" $clusterName $access $suffix | quote }}
      allotment.cluster: {{ $clusterName | quote }}
      allotment.provider: "aws"
      allotment.created-by: {{ $createdBy | quote }}
      {{ if ne $expiresAt "" }}
      allotment.expires-at: {{ $expiresAt | quote }}
      {{ end }}
      {{ if ne (index $subnet "roleTag") "" }}
      {{ index $subnet "roleTag" }}: "1"
      {{ end }}
  providerConfigRef:
    name: default
{{- end }}
{{- end }}
{{- range $zone := $zoneData }}
{{- $suffix := index $zone "suffix" }}
---
apiVersion: ec2.aws.upbound.io/v1beta1
kind: EIP
metadata:
  name: {{ printf "%s-nat-eip-%s" $clusterName $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: eip-{{ $suffix }}
  labels:
    nat-zone: {{ $suffix }}
spec:
  forProvider:
    region: {{ $region | quote }}
    domain: vpc
    tags:
      Name: {{ printf "%s-nat-eip-%s" $clusterName $suffix | quote }}
      allotment.cluster: {{ $clusterName | quote }}
      allotment.provider: "aws"
      allotment.created-by: {{ $createdBy | quote }}
      {{ if ne $expiresAt "" }}
      allotment.expires-at: {{ $expiresAt | quote }}
      {{ end }}
  providerConfigRef:
    name: default
---
apiVersion: ec2.aws.upbound.io/v1beta1
kind: NATGateway
metadata:
  name: {{ printf "%s-natgw-%s" $clusterName $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: natgw-{{ $suffix }}
  labels:
    nat-zone: {{ $suffix }}
spec:
  forProvider:
    region: {{ $region | quote }}
    connectivityType: public
    allocationIdSelector:
      matchControllerRef: true
      matchLabels:
        nat-zone: {{ $suffix }}
    subnetIdSelector:
      matchControllerRef: true
      matchLabels:
        access: public
        zone: {{ $suffix }}
    tags:
      Name: {{ printf "%s-natgw-%s" $clusterName $suffix | quote }}
      allotment.cluster: {{ $clusterName | quote }}
      allotment.provider: "aws"
      allotment.created-by: {{ $createdBy | quote }}
      {{ if ne $expiresAt "" }}
      allotment.expires-at: {{ $expiresAt | quote }}
      {{ end }}
  providerConfigRef:
    name: default
---
apiVersion: ec2.aws.upbound.io/v1beta1
kind: RouteTable
metadata:
  name: {{ printf "%s-rt-private-%s" $clusterName $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: rt-private-{{ $suffix }}
  labels:
    route: private
    zone: {{ $suffix }}
spec:
  forProvider:
    region: {{ $region | quote }}
    vpcIdSelector:
      matchControllerRef: true
    tags:
      Name: {{ printf "%s-rt-private-%s" $clusterName $suffix | quote }}
      allotment.cluster: {{ $clusterName | quote }}
      allotment.provider: "aws"
      allotment.created-by: {{ $createdBy | quote }}
      {{ if ne $expiresAt "" }}
      allotment.expires-at: {{ $expiresAt | quote }}
      {{ end }}
  providerConfigRef:
    name: default
---
apiVersion: ec2.aws.upbound.io/v1beta1
kind: Route
metadata:
  name: {{ printf "%s-route-private-%s" $clusterName $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: route-private-{{ $suffix }}
spec:
  forProvider:
    region: {{ $region | quote }}
    destinationCidrBlock: 0.0.0.0/0
    natGatewayIdSelector:
      matchControllerRef: true
      matchLabels:
        nat-zone: {{ $suffix }}
    routeTableIdSelector:
      matchControllerRef: true
      matchLabels:
        route: private
        zone: {{ $suffix }}
  providerConfigRef:
    name: default
{{- end }}
{{- $hasPodSubnet := false }}
{{- range $zone := $zoneData }}
{{- if ne (index $zone "podSubnetId") "" }}
{{- $hasPodSubnet = true }}
{{- end }}
{{- end }}
{{- if $hasPodSubnet }}
---
apiVersion: allotment.io/v1alpha1
kind: XInfra
status:
  podSubnets:
{{- range $zone := $zoneData }}
{{- if ne (index $zone "podSubnetId") "" }}
    {{ index $zone "suffix" }}: {{ index $zone "podSubnetId" | quote }}
{{- end }}
{{- end }}
{{- end }}
{{- $routeAssociations := list
  (dict "access" "public" "route" "public")
  (dict "access" "private" "route" "private")
  (dict "access" "pod" "route" "private")
}}
{{- range $association := $routeAssociations }}
{{- $access := index $association "access" }}
{{- $route := index $association "route" }}
{{- range $zone := $zoneData }}
{{- $suffix := index $zone "suffix" }}
---
apiVersion: ec2.aws.upbound.io/v1beta1
kind: RouteTableAssociation
metadata:
  name: {{ printf "%s-rta-%s-%s" $clusterName $access $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: rta-{{ $access }}-{{ $suffix }}
spec:
  forProvider:
    region: {{ $region | quote }}
    routeTableIdSelector:
      matchControllerRef: true
      matchLabels:
        route: {{ $route }}
        {{ if eq $route "private" }}
        zone: {{ $suffix }}
        {{ end }}
    subnetIdSelector:
      matchControllerRef: true
      matchLabels:
        access: {{ $access }}
        zone: {{ $suffix }}
  providerConfigRef:
    name: default
{{- end }}
{{- end }}
---
apiVersion: eks.aws.upbound.io/v1beta2
kind: NodeGroup
metadata:
  name: {{ printf "%s-nodegroup" $clusterName | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: eks-nodegroup
spec:
  forProvider:
    region: {{ $region | quote }}
    clusterNameSelector:
      matchControllerRef: true
    nodeRoleArnSelector:
      matchControllerRef: true
      matchLabels:
        role: eks-node
    subnetIdSelector:
      matchControllerRef: true
      matchLabels:
        access: private
    instanceTypes:
    - m5.xlarge
    scalingConfig:
      desiredSize: {{ $desiredNodes }}
      minSize: {{ $desiredNodes }}
      maxSize: {{ $maxNodes }}
    tags:
      Name: {{ printf "%s-nodegroup" $clusterName | quote }}
      allotment.cluster: {{ $clusterName | quote }}
      allotment.provider: "aws"
      allotment.created-by: {{ $createdBy | quote }}
      {{ if ne $expiresAt "" }}
      allotment.expires-at: {{ $expiresAt | quote }}
      {{ end }}
  providerConfigRef:
    name: default
{{- range $zone := $zoneData }}
{{- $suffix := index $zone "suffix" }}
{{- $zoneName := index $zone "zone" }}
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  name: {{ printf "%s-eniconfig-%s" $clusterName $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: eniconfig-{{ $suffix }}
spec:
  deletionPolicy: Orphan
  forProvider:
    manifest:
      apiVersion: crd.k8s.amazonaws.com/v1alpha1
      kind: ENIConfig
      metadata:
        name: {{ $zoneName | quote }}
      spec:
        securityGroups:
        - {{ $clusterSecurityGroup | quote }}
        subnet: {{ default "REPLACE" (index $zone "podSubnetId") | quote }}
  providerConfigRef:
    name: runtime-infra
---
apiVersion: kubernetes.crossplane.io/v1alpha2
kind: Object
metadata:
  name: {{ printf "%s-pod-cidr-probe-%s" $clusterName $suffix | quote }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pod-cidr-probe-{{ $suffix }}
spec:
  readiness:
    policy: DeriveFromCelQuery
    celQuery: has(object.status.succeeded) && object.status.succeeded >= 1
  forProvider:
    manifest:
      apiVersion: batch/v1
      kind: Job
      metadata:
        name: {{ printf "%s-pod-cidr-probe-%s" $clusterName $suffix | quote }}
        namespace: kube-system
      spec:
        backoffLimit: 12
        template:
          spec:
            restartPolicy: Never
            nodeSelector:
              topology.kubernetes.io/zone: {{ $zoneName | quote }}
            containers:
            - name: probe
              image: public.ecr.aws/docker/library/busybox:1.37.0
              env:
              - name: POD_IP
                valueFrom:
                  fieldRef:
                    fieldPath: status.podIP
              command:
              - sh
              - -ec
              - |
                case "$POD_IP" in
                  100.64.*) exit 0 ;;
                  *) echo "pod IP $POD_IP is outside 100.64.0.0/16"; exit 1 ;;
                esac
  providerConfigRef:
    name: runtime-infra
{{- end }}
{{- end }}
{{- end }}
