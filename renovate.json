{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "labels": [
    "dependencies"
  ],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "matchFileNames": [
        "aqua.yaml"
      ],
      "groupName": "aqua-managed tools"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^xpkg\\./"
      ],
      "groupName": "Crossplane packages"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^aqua\\.yaml$/"
      ],
      "matchStrings": [
        "- name: (?<depName>[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+)@(?<currentValue>[^\\s]+)",
        "ref: (?<currentValue>v[0-9.]+) # renovate: depName=(?<depName>[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^(bootstrap|platform)/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>xpkg\\.(?:upbound|crossplane)\\.io/[^:\\s\"']+):(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "python -m pip install (?<depName>[A-Za-z0-9_.-]+)==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi"
    }
  ]
}
